PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
# Opcional: origens extras autorizadas no CORS separadas por vírgula
ALLOWED_ORIGINS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ocorrencia_online
# Para MySQL na nuvem (Aiven, TiDB Cloud, etc.), ative DB_SSL=true
DB_SSL=false
# Opcional: caminho do certificado CA (.pem) caso o provedor forneça (ex.: ca.pem)
DB_SSL_CA=
# Em provedores com CA próprio sem arquivo .pem configurado, você pode definir DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Em produção, gere uma chave aleatória com 32+ caracteres (ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRES_IN=8h
# Opcional no Windows: caminho da pasta bin do MySQL se mysqldump/mysql não estiver no PATH
MYSQL_BIN_PATH=
