PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
# Opcional: origens extras autorizadas no CORS separadas por vírgula
ALLOWED_ORIGINS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ocorrencia_online
# Em produção, gere uma chave aleatória com 32+ caracteres (ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRES_IN=8h
# Opcional no Windows: caminho da pasta bin do MySQL se mysqldump/mysql não estiver no PATH
MYSQL_BIN_PATH=
